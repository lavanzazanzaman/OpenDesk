/* Violet theme: the Windows streamer's dark MetroDark layout with a violet accent (#8B6CFF), slightly violet-tinted
   greys and rounded controls. */

* { font-family: "Noto Sans", "Cantarell", "DejaVu Sans"; }
QWidget { color: #C9C4D8; font-size: 15px; }

#header, #footer { background: #1B1924; }
#header { border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom: 1px solid #262233; }
#footer { border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; border-top: 1px solid #262233; }
#body, #tabStrip { background: #15131C; }
#page, #page QScrollArea, #page QScrollArea > QWidget > QWidget { background: #100F16; border: none; }

QLabel#windowTitle { color: #FFFFFF; font-size: 14px; font-weight: 600; }
QPushButton#windowButton, QPushButton#closeButton { background: transparent; border: none; border-radius: 0; padding: 0; min-height: 0; min-width: 0; }
QPushButton#windowButton:hover { background: #262233; }
QPushButton#closeButton { border-top-right-radius: 10px; }
QPushButton#closeButton:hover { background: #C42B1C; }
QLabel#footerStatus { color: #C9C4D8; font-size: 12px; }
QLabel#footerVersion { color: #6E6A7C; font-size: 12px; }

QPushButton#tabButton {
    background: #15131C; color: #8A8699; font-size: 13px; font-weight: bold; letter-spacing: 1px;
    text-align: left; padding: 0 16px 0 13px; border: none; border-left: 3px solid transparent;
    border-radius: 0; min-height: 46px; max-height: 46px; min-width: 150px; max-width: 150px;
}
QPushButton#tabButton:hover { color: #FFFFFF; background: #1B1924; }
QPushButton#tabButton:checked { color: #FFFFFF; background: #1E1B2B; border-left: 3px solid #8B6CFF; }

QPushButton#imageButton { background: transparent; border: none; border-radius: 6px; padding: 0; min-height: 0; min-width: 0; }
QPushButton#imageButton:hover { background: rgba(139, 108, 255, 0.18); }
QPushButton#imageButton:pressed { background: rgba(139, 108, 255, 0.32); }

QLabel#sectionLabel { font-weight: bold; font-size: 14px; color: #FFFFFF; }
QLabel#aboutKey { color: #8A8699; font-size: 14px; }
QLabel#aboutValue { font-size: 14px; }
QLabel#warning { color: #FFA500; font-size: 14px; }
QLabel#accountIds { color: #8A8699; font-size: 14px; }
QLabel#platformName { font-weight: bold; font-size: 14px; }
QLabel#footerKey { color: #8A8699; font-size: 12px; }
QLabel#footerValue { color: #B9A8FF; font-size: 12px; }
QLabel#mediaLabel { color: #C9C4D8; font-size: 14px; }
QLabel a { color: #A58CFF; }

QPushButton {
    color: #FFFFFF; font-size: 14px; background: #1E1B29;
    border: 1px solid #332E45; border-radius: 5px; padding: 0 12px 2px 12px; min-height: 30px; min-width: 30px;
}
QPushButton:hover { border-color: #8B6CFF; }
QPushButton:pressed, QPushButton:checked { background: #2A2540; border-color: #8B6CFF; }
QPushButton:disabled { color: #5E5A6B; border-color: #262233; }
QPushButton#linkButton { background: transparent; border: none; color: #FFFFFF; padding: 0; text-align: left; }
QPushButton#linkButton:hover { color: #A58CFF; }

QCheckBox { spacing: 8px; min-height: 30px; font-size: 15px; }
QCheckBox:disabled { color: #5E5A6B; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid #3A3450; border-radius: 4px; background: #0B0A10; }
QCheckBox::indicator:hover { border-color: #8B6CFF; }
QCheckBox::indicator:checked { background: #8B6CFF; border-color: #8B6CFF; image: url(:/theme/check.svg); }

QComboBox {
    background: #0B0A10; border: 1px solid #332E45; border-radius: 5px; padding: 3px 8px; min-height: 22px; font-size: 12px;
}
QComboBox:hover { border-color: #5C4BA8; }
QComboBox:focus, QComboBox:on { border-color: #8B6CFF; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox::down-arrow { image: url(:/theme/arrow.svg); width: 10px; height: 6px; }
QComboBox QAbstractItemView {
    background: #0B0A10; border: 1px solid #332E45; outline: none; font-size: 12px;
    selection-background-color: #8B6CFF; selection-color: #FFFFFF;
}
QComboBox QAbstractItemView::item { min-height: 24px; padding-left: 6px; }
QComboBox QAbstractItemView::item:hover { background: #2A2540; }

QSlider::groove:horizontal { height: 4px; background: #262233; border: none; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #8B6CFF; border-radius: 2px; }
QSlider::handle:horizontal { background: #C9C4D8; width: 14px; height: 14px; margin: -5px 0; border-radius: 7px; }
QSlider::handle:horizontal:hover { background: #FFFFFF; }
QSlider::handle:horizontal:pressed { background: #B9A8FF; }

QLineEdit, QKeySequenceEdit {
    font-size: 13px; background: #0B0A10; border: 1px solid #332E45; border-radius: 5px; padding: 3px 8px;
    selection-background-color: rgba(139, 108, 255, 110); selection-color: #FFFFFF;
}
QLineEdit:hover, QKeySequenceEdit:hover { border-color: #5C4BA8; }
QLineEdit:focus, QKeySequenceEdit:focus { border-color: #8B6CFF; }

QScrollBar:vertical { background: transparent; width: 8px; margin: 0; }
QScrollBar::handle:vertical { background: rgba(139, 108, 255, 70); min-height: 24px; border-radius: 4px; }
QScrollBar::handle:vertical:hover { background: rgba(139, 108, 255, 130); }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page { background: none; height: 0; }

QToolTip { background: #1B1924; color: #C9C4D8; border: 1px solid #3A3450; padding: 5px; font-size: 12px; }

QMenu { background: #1B1924; border: 1px solid #3A3450; padding: 3px; font-size: 14px; }
QMenu::item { padding: 6px 24px 6px 8px; color: #C9C4D8; border-radius: 4px; }
QMenu::item:selected { background: #2A2540; color: #FFFFFF; }
QMenu::icon { padding-left: 8px; }

QDialog#vdDialog { background: #1B1924; border: 1px solid #3A3450; }

/* settings pages: cards of rows */
QFrame#card { background: #17151F; border: 1px solid #23202F; border-radius: 10px; }
QLabel#cardTitle { color: #B9A8FF; font-size: 12px; font-weight: bold; letter-spacing: 1px; }
QWidget#settingRow { background: transparent; }
QLabel#settingTitle { color: #FFFFFF; font-size: 14px; }
QLabel#settingDescription { color: #8A8699; font-size: 12px; }
QFrame#rowSeparator { background: #23202F; border: none; }
QLabel#pageNote { color: #8A8699; font-size: 13px; }

/* switches: check boxes without text in settings rows */
QCheckBox#switch { spacing: 0; min-height: 22px; }
QCheckBox#switch::indicator { width: 36px; height: 20px; border: none; background: transparent; image: url(:/theme/switch-off.svg); }
QCheckBox#switch::indicator:checked { image: url(:/theme/switch-on.svg); background: transparent; }
QCheckBox#switch::indicator:disabled { image: url(:/theme/switch-off-disabled.svg); }
QCheckBox#switch::indicator:hover { border: none; }
QLabel#settingTitle:disabled, QLabel#settingDescription:disabled { color: #5E5A6B; }
QSlider::sub-page:horizontal:disabled { background: #3A3450; }
QSlider::handle:horizontal:disabled { background: #5E5A6B; }
QLabel#settingWarning { color: #F5A524; font-size: 12px; }
QLabel#summaryOk { color: #46A758; font-size: 13px; font-weight: 600; padding: 2px 0 4px 2px; }
QLabel#summaryWarning { color: #F5A524; font-size: 13px; font-weight: 600; padding: 2px 0 4px 2px; }
QScrollArea#setupScroll, QScrollArea#setupScroll > QWidget > QWidget#qt_scrollarea_viewport { background: transparent; border: none; }
QScrollArea#setupScroll QWidget#qt_scrollarea_viewport { background: transparent; }
QProgressBar#encodeLoad { background: #0B0A10; border: 1px solid #332E45; border-radius: 5px; }
QProgressBar#encodeLoad::chunk { background: #46A758; border-radius: 4px; }
QProgressBar#encodeLoad[level="ok"]::chunk { background: #F5A524; }
QProgressBar#encodeLoad[level="tight"]::chunk { background: #E5484D; }
