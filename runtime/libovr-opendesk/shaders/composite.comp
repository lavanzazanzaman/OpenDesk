#version 450
// One layer into one eye's stream image. The stream image is the headset's *defoveation-warped* layout at encoded
// size (headset DefoveationPrimitive: screen s -> texture t: s<.25: 2s^2, s>.75: 1-2(1-s)^2, else 1.5(s-.25)+.125),
// covering the headset FOV. Pixels are packed XRGB8888 (sRGB-encoded) in an R32_UINT DMA-BUF shared with the encoder.
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, r32ui) uniform uimage2D stream_image;
#ifdef MULTISAMPLED
layout(set = 0, binding = 1) uniform sampler2DMS layer_image;
vec4 resolved(ivec2 p) {
    p = clamp(p, ivec2(0), textureSize(layer_image) - 1);
    vec4 c = vec4(0.0);
    int count = textureSamples(layer_image);
    for (int i = 0; i < count; ++i) c += texelFetch(layer_image, p, i);
    return c / float(count);
}
vec4 sample_layer(vec2 uv) {
    vec2 p = uv * vec2(textureSize(layer_image)) - 0.5;
    ivec2 i = ivec2(floor(p)); vec2 f = fract(p);
    return mix(mix(resolved(i), resolved(i + ivec2(1, 0)), f.x),
               mix(resolved(i + ivec2(0, 1)), resolved(i + ivec2(1, 1)), f.x), f.y);
}
vec2 texel_size() { return 1.0 / vec2(textureSize(layer_image)); }
#else
layout(set = 0, binding = 1) uniform sampler2D layer_image;
vec4 sample_layer(vec2 uv) { return texture(layer_image, uv); }
vec2 texel_size() { return 1.0 / vec2(textureSize(layer_image, 0)); }
#endif

layout(push_constant) uniform params
{
	ivec4 info;    // x: 0 clear, 1 projection, 2 quad; y: flags (1 origin bottom-left, 2 first layer: no blending, 4 premultiplied, 8 opaque)
	               // w: fovea target: eye render target width | height << 16 (0: the warped eye image)
	vec4 fov_out;  // stream FOV tangents: left, right, up, down
	vec4 rect;     // layer image sub-rectangle (normalized): x0, y0, x1, y1
	vec4 a;        // projection: layer FOV tangents (left, right, up, down); quad: half width, half height, alpha, 0
	vec4 m0, m1, m2; // quad: eye->quad rotation rows (xyz) and eye position in quad space (w)
	vec4 effects; // gamma (or fovea target: periphery width x 4096 + height), sharpening; fovea target: its top-left in the eye render target (px)
} pc;

// the headset's defoveation: screen s -> stream image t (unwarp is its inverse)
float warp(float s)
{
	if (s < 0.25) return 2.0 * s * s;
	if (s > 0.75) return 1.0 - 2.0 * (1.0 - s) * (1.0 - s);
	return 1.5 * (s - 0.25) + 0.125;
}

float unwarp(float t)
{
	if (t < 0.125) return sqrt(t / 2.0);
	if (t > 0.875) return 1.0 - sqrt((1.0 - t) / 2.0);
	return (t - 0.125) / 1.5 + 0.25;
}

vec3 to_srgb(vec3 c)
{
	c = clamp(c, 0.0, 1.0);
	return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(0.0031308, c));
}

vec3 from_srgb(vec3 c)
{
	return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(0.04045, c));
}

// stream image position (pixels, row 0 = top) -> layer image uv; false: the view ray misses the layer
bool layer_uv(vec2 pos, out vec2 uv, out float alpha_scale)
{
	uv = vec2(-1.0);
	alpha_scale = 1.0;
	vec2 t = pos / vec2(imageSize(stream_image));
	// stream image -> eye screen position: the headset's defoveation warp, or for a fovea crop 1:1 pixels at its place
	vec2 eye = vec2(pc.info.w & 0xffff, (pc.info.w >> 16) & 0xffff);
	vec2 s = pc.info.w != 0 ? (pc.effects.zw + pos) / eye : vec2(unwarp(t.x), unwarp(t.y));
	vec3 dir = vec3(mix(-pc.fov_out.x, pc.fov_out.y, s.x), mix(pc.fov_out.z, -pc.fov_out.w, s.y), -1.0);

	if (pc.info.x == 1) // projection: same eye, the layer's own FOV
	{
		uv = vec2((dir.x + pc.a.x) / (pc.a.x + pc.a.y), (pc.a.z - dir.y) / (pc.a.z + pc.a.w));
	}
	else // quad: intersect the view ray with the quad plane (z = 0, facing +z)
	{
		vec3 d = vec3(dot(pc.m0.xyz, dir), dot(pc.m1.xyz, dir), dot(pc.m2.xyz, dir));
		vec3 o = vec3(pc.m0.w, pc.m1.w, pc.m2.w);
		if (pc.info.x == 4) {
			vec3 ad = abs(d); vec2 q; float major; int face;
			if (ad.x >= ad.y && ad.x >= ad.z) {
				major = ad.x; face = d.x > 0.0 ? 0 : 1;
				q = vec2(d.x > 0.0 ? -d.z : d.z, -d.y);
			} else if (ad.y >= ad.z) {
				major = ad.y; face = d.y > 0.0 ? 2 : 3;
				q = vec2(d.x, d.y > 0.0 ? d.z : -d.z);
			} else {
				major = ad.z; face = d.z > 0.0 ? 4 : 5;
				q = vec2(d.z > 0.0 ? d.x : -d.x, -d.y);
			}
			if (face != pc.info.z) return false;
			uv = q / major * 0.5 + 0.5;
		} else if (pc.info.x == 3) {
			float a = dot(d.xz,d.xz), b = dot(o.xz,d.xz), c = dot(o.xz,o.xz)-pc.a.x*pc.a.x;
			float discriminant = b*b-a*c;
			if (a < 1e-8 || discriminant < 0.0) return false;
			float k = (-b+sqrt(discriminant))/a;
			if (k <= 0.0) return false;
			vec3 hit = o+k*d;
			uv = vec2(atan(hit.x,-hit.z)/pc.a.y+0.5, 0.5-hit.y/pc.a.z);
		} else {
		if (abs(d.z) < 1e-6)
			return false;
		float k = -o.z / d.z;
		if (k <= 0.0)
			return false;
		vec3 hit = o + k * d;
		uv = vec2(hit.x / (2.0 * pc.a.x) + 0.5, 0.5 - hit.y / (2.0 * pc.a.y));
		alpha_scale = pc.a.z;
		}
	}
	bool inside = all(greaterThanEqual(uv, vec2(0.0))) && all(lessThanEqual(uv, vec2(1.0)));
	if ((pc.info.y & 1) != 0)
		uv.y = 1.0 - uv.y;
	uv = mix(pc.rect.xy, pc.rect.zw, uv);
	return inside;
}

void main()
{
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(stream_image);
	if (p.x >= size.x || p.y >= size.y)
		return;
	if (pc.info.x == 0)
	{
		imageStore(stream_image, p, uvec4(0xff000000u));
		return;
	}
	if (pc.info.x == 5) {
		// "Use Fov Stencil" (effects.y: its margin, 0 off): games may leave the hidden area unrendered - stale
		// pixels (a loading screen, the last scene) - so it is black in the stream, the shape ovr_GetFovStencil gives
		if (pc.effects.y > 0.0)
		{
			vec2 eye = vec2(pc.info.w & 0xffff, (pc.info.w >> 16) & 0xffff);
			vec2 t = (vec2(p) + 0.5) / vec2(size);
			vec2 s = pc.info.w != 0 ? (pc.effects.zw + vec2(p) + 0.5) / eye : vec2(unwarp(t.x), unwarp(t.y));
			vec2 tan_xy = vec2(mix(-pc.fov_out.x, pc.fov_out.y, s.x), mix(pc.fov_out.z, -pc.fov_out.w, s.y));
			// the ellipse is the one inside the game's FOV (a: left, right, up, down - cropped by the FOV settings)
			vec2 semi = vec2(atan(tan_xy.x >= 0.0 ? pc.a.y : pc.a.x), atan(tan_xy.y >= 0.0 ? pc.a.z : pc.a.w)) * pc.effects.y;
			vec2 q = atan(tan_xy) / semi;
			if (dot(q, q) > 1.0)
			{
				imageStore(stream_image, p, uvec4(0xff000000u));
				return;
			}
		}
		uint prev = imageLoad(stream_image, p).x;
		// output gamma (effects.x: the exponent, applied to linear light - the Windows streamer's pow(c, 0.9 / Gamma))
		vec3 c = from_srgb(vec3((prev >> 16) & 255u, (prev >> 8) & 255u, prev & 255u) / 255.0);
		uvec3 rgb = uvec3(to_srgb(pow(c, vec3(pc.effects.x))) * 255.0 + 0.5);
		imageStore(stream_image, p, uvec4(0xff000000u | (rgb.r << 16) | (rgb.g << 8) | rgb.b));
		return;
	}
	// one stream pixel can cover several layer texels (the warped periphery, a coarse foveated periphery most):
	// average a grid of up to 4 x 4 samples over it, like the Windows streamer's mipmapped anisotropic sampling -
	// one bilinear tap would alias and shimmer next to the sharp fovea
	vec2 centre = vec2(p) + 0.5;
	vec2 sample_uv, uv_x, uv_y;
	float alpha_scale, unused;
	bool inside = layer_uv(centre, sample_uv, alpha_scale);
	int n = 1;
	float footprint = 1.0;
	if (pc.info.x != 4 && layer_uv(centre + vec2(1.0, 0.0), uv_x, unused) && layer_uv(centre + vec2(0.0, 1.0), uv_y, unused))
	{
		vec2 texels = vec2(texel_size());
		vec2 fx = abs(uv_x - sample_uv) / texels, fy = abs(uv_y - sample_uv) / texels;
		footprint = max(max(fx.x, fx.y), max(fy.x, fy.y));
		n = clamp(int(ceil(footprint - 0.2)), 1, 4);
	}
	// Fovea crop: the headset blends it in over a thin ring (radius 0.45-0.5 of the crop) onto the periphery, which
	// it draws from a far coarser image, nearest-sampled - a visible circle. So the crop loses detail gradually:
	// from radius 0.12 to 0.38 an ever wider box filter, up to the size of a periphery pixel, then from 0.36 to 0.45
	// it turns into what the periphery shows there (the periphery pixel the headset picks for this spot, computed
	// like the periphery's own, blocks included). At the ring both are the same picture.
	float blur = 0.0, fade = 0.0;
	vec4 soft = vec4(0.0), coarse = vec4(0.0);
	if (pc.info.w != 0 && pc.effects.x > 0.0)
	{
		float r = length((vec2(p) + 0.5) / vec2(size) - 0.5);
		int packed = int(pc.effects.x);
		vec2 psize = vec2(packed / 4096, packed % 4096);
		vec2 eye = vec2(pc.info.w & 0xffff, (pc.info.w >> 16) & 0xffff);
		vec2 eye_px = eye / (psize * 1.5); // eye pixels per periphery pixel (the warp's centre density)
		blur = smoothstep(0.12, 0.38, r);
		fade = smoothstep(0.36, 0.45, r);
		if (blur > 0.0 && fade < 1.0)
		{
			vec2 k = mix(vec2(1.0), max(eye_px, vec2(1.0)), blur); // box size in eye pixels
			int m = clamp(int(ceil(max(k.x, k.y) * footprint)), 1, 4);
			vec4 sum = vec4(0.0);
			for (int j = 0; j < m; ++j)
				for (int i = 0; i < m; ++i)
				{
					vec2 tap_uv;
					if (layer_uv(vec2(p) + 0.5 + ((vec2(i, j) + 0.5) / float(m) - 0.5) * k, tap_uv, unused))
						sum += sample_layer(tap_uv);
				}
			soft = sum / float(m * m);
		}
		if (fade > 0.0)
		{
			vec2 s = (pc.effects.zw + vec2(p) + 0.5) / eye;
			vec2 texel = floor(vec2(warp(s.x), warp(s.y)) * psize); // the periphery pixel shown here
			// as many samples per periphery pixel as the periphery pass takes (its footprint, up to 4 x 4)
			int m = clamp(int(ceil(max(eye_px.x, eye_px.y) * footprint - 0.2)), 1, 4);
			vec4 sum = vec4(0.0);
			for (int j = 0; j < m; ++j)
				for (int i = 0; i < m; ++i)
				{
					vec2 tt = (texel + (vec2(i, j) + 0.5) / float(m)) / psize;
					vec2 ss = vec2(unwarp(tt.x), unwarp(tt.y));
					vec2 tap_uv;
					if (layer_uv(ss * eye - pc.effects.zw, tap_uv, unused))
						sum += sample_layer(tap_uv);
				}
			coarse = sum / float(m * m);
		}
	}
	vec4 src;
	if (n == 1)
		src = inside ? sample_layer(sample_uv) : vec4(0.0);
	else
	{
		// premultiplied average; taps off the layer count as transparent
		vec4 sum = vec4(0.0);
		int hits = 0;
		for (int j = 0; j < n; ++j)
			for (int i = 0; i < n; ++i)
			{
				vec2 tap_uv;
				if (!layer_uv(vec2(p) + (vec2(i, j) + 0.5) / float(n), tap_uv, unused))
					continue;
				vec4 c = sample_layer(tap_uv);
				if ((pc.info.y & 8) != 0)
					c.a = 1.0;
				sum += (pc.info.y & 4) != 0 ? c : vec4(c.rgb * c.a, c.a);
				++hits;
			}
		inside = hits > 0;
		src = sum / float(n * n);
		if ((pc.info.y & 4) == 0)
			src.rgb = src.a > 0.0 ? src.rgb / src.a : vec3(0.0);
	}
	if (inside && n == 1 && pc.info.x == 1 && pc.effects.y > 0.0 && blur == 0.0) {
		vec2 d = texel_size();
		vec3 n = sample_layer(clamp(sample_uv + vec2(0,d.y), pc.rect.xy, pc.rect.zw)).rgb;
		vec3 s = sample_layer(clamp(sample_uv - vec2(0,d.y), pc.rect.xy, pc.rect.zw)).rgb;
		vec3 e = sample_layer(clamp(sample_uv + vec2(d.x,0), pc.rect.xy, pc.rect.zw)).rgb;
		vec3 w = sample_layer(clamp(sample_uv - vec2(d.x,0), pc.rect.xy, pc.rect.zw)).rgb;
		vec3 lo = min(src.rgb, min(min(n,s), min(e,w)));
		vec3 hi = max(src.rgb, max(max(n,s), max(e,w)));
		vec3 strength = clamp(min(lo, 1.0-hi) / max(hi, vec3(0.0001)), 0.0, 1.0);
		vec3 weight = -sqrt(strength) * mix(0.0, 0.18, pc.effects.y);
		src.rgb = clamp((src.rgb + weight*(n+s+e+w)) / (1.0+4.0*weight), lo, hi);
	}
	if (blur > 0.0 && fade < 1.0)
		src = soft;
	if (fade > 0.0)
		src = mix(src, coarse, fade);
	if ((pc.info.y & 8) != 0 && inside)
		src.a = 1.0;
	src.a *= alpha_scale;
	float layer_alpha = 1.0 - float((pc.info.y >> 8) & 255) / 255.0; // the layer's alpha (color scale)
	src.a *= layer_alpha;
	if ((pc.info.y & 4) != 0) // premultiplied: the colour fades with it
		src.rgb *= layer_alpha;

	vec3 color;
	if ((pc.info.y & 2) != 0) // first layer: opaque base
		color = inside ? src.rgb : vec3(0.0);
	else
	{
		if (!inside || src.a <= 0.0)
			return;
		uint prev = imageLoad(stream_image, p).x;
		vec3 dst = from_srgb(vec3((prev >> 16) & 0xffu, (prev >> 8) & 0xffu, prev & 0xffu) / 255.0);
		vec3 rgb = (pc.info.y & 4) != 0 ? src.rgb : src.rgb * src.a;
		color = rgb + dst * (1.0 - src.a);
	}
	uvec3 c = uvec3(to_srgb(color) * 255.0 + 0.5);
	imageStore(stream_image, p, uvec4(0xff000000u | (c.r << 16) | (c.g << 8) | c.b));
}
